# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# "Order Status Lookup" automation step — lets customers ask
# "track 1024" on WhatsApp. Calls the Vanamati Shopify app's
# order-status endpoint; the app verifies the sender's phone against
# the order before answering. Both required for the step to run.
# The key is a DEDICATED token (the app's ORDER_STATUS_API_KEY), not
# the app's admin master key — it can do exactly one thing.
# VANAMATI_APP_URL=https://app.vanamati.com
# VANAMATI_ORDER_STATUS_KEY=generate-a-long-random-string

# NOTE: the product feed from the Vanamati Shopify app reuses the
# existing WACRM_API_KEY (Bearer auth on /api/webhooks/vanamati/products
# and /api/backfill/products). The key needs the 'products:write' scope
# added — mint or edit one in Settings → API Keys. No extra env var
# needed on WACRM's side for this.

# WhatsApp Business Commerce catalog ID — enables the send_product_catalog
# AI tool. Multi-Product Message with native product cards (image, price,
# View button) inside the customer's 24h session window; free per send.
# Setup: Meta Business Manager → Commerce Manager → create catalog →
# copy the catalog ID here. Products sync from Shopify via Meta's
# Commerce app. Without this, the AI falls back to the text product list.
# WHATSAPP_CATALOG_ID=

# WhatsApp Carousel Template (paid MARKETING template) — enables the
# send_product_carousel AI tool. Sends a horizontally-scrollable
# carousel of product cards with images + Shop Now buttons, works
# OUTSIDE the 24h session window (re-engagement). Each send is billed
# at Meta's MARKETING rate (~₹0.85 in India).
#
# Setup: Meta Business Manager → Message Templates → Create → Carousel,
# category MARKETING; body "Hi {{1}}!..."; per-card body
# "{{1}} — from ₹{{2}}"; per-card URL button
# "https://vanamati.com/products/{{1}}". Submit → wait 1-3 days for
# Meta approval → copy template name here. Language defaults to 'en'.
# WHATSAPP_CAROUSEL_TEMPLATE_NAME=
# WHATSAPP_CAROUSEL_TEMPLATE_LANG=en

# ------------------------------------------------------------------
# Silence re-engagement cron (Phase 5)
# ------------------------------------------------------------------
# GET /api/cron/re-engagement finds customers who haven't messaged
# in a while and sends them a Meta-approved MARKETING template to
# re-open the conversation. Off by default — set the template name
# to enable.
#
# WhatsApp policy: sending outside the 24hr session window requires
# a MARKETING category template. Register + approve it in Meta's
# WhatsApp Business Manager BEFORE setting the env var below; a
# template that doesn't exist errors #132001 on every send.
#
# Auth: reuses AUTOMATION_CRON_SECRET (x-cron-secret header).
#
# RE_ENGAGEMENT_TEMPLATE_NAME=re_engagement_v1
# RE_ENGAGEMENT_TEMPLATE_LANG=en
# RE_ENGAGEMENT_SILENCE_DAYS=7      # customer silent this long → candidate
# RE_ENGAGEMENT_COOLDOWN_DAYS=30    # min gap between re-engagements per contact
# RE_ENGAGEMENT_MAX_AGE_DAYS=90     # skip customers dark longer than this
# RE_ENGAGEMENT_BATCH_SIZE=100      # per-run cap

# ------------------------------------------------------------------
# Team notifications (optional)
# ------------------------------------------------------------------
# When the AI hands off a conversation to a human, we POST a summary
# to this Slack Incoming Webhook so the team channel pings someone
# to pick it up. Unset = no notification (handoff still happens; it
# just sits in the inbox until an agent notices).
#
# Create at https://api.slack.com/messaging/webhooks — the URL is
# secret (anyone with it can post to your channel), so treat like a
# credential and never commit the real value.
# Example format (do NOT commit the real URL):
#   SLACK_WHATSAPP_ALERT_TEAM_WEBHOOK_URL=<your Slack Incoming Webhook URL from api.slack.com/messaging/webhooks>

# Public base URL of THIS app (the WACRM inbox). Used to build
# clickable "Open in inbox" links in team notifications and invite
# emails. No trailing slash. Leave unset in dev and the notification
# will simply omit the link.
# NEXT_PUBLIC_APP_URL=https://social.vanamati.com

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# Cap total tokens spent per contact per 24h. Defaults to 20000 (~50
# replies at typical prompt+output sizes). Protects the BYO key from
# runaway spend if a bot/broken customer sends thousands of messages
# a day. Set to 0 to disable the check entirely.
# AI_DAILY_TOKEN_BUDGET_PER_CONTACT=20000

# Adaptive message-batch debounce — seconds to wait after an inbound
# to see if the customer sends another fragment (typical WhatsApp
# typing pattern). Only fires when the customer's previous message
# was <15s ago; isolated messages reply immediately. Default 6.
# AI_MESSAGE_BATCH_WAIT_SECONDS=6

# Model routing (Anthropic only) — the "fast model" the router
# downgrades simple turns to. Sonnet-configured accounts get their
# greetings + generic Q&A answered by this model instead, dropping
# average cost per reply by ~50%. Default is Haiku 4.5. Router is
# conservative: any buying/close/handoff signal stays on the
# account's configured model.
# AI_FAST_MODEL_ANTHROPIC=claude-haiku-4-5-20251001

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20
